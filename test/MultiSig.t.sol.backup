pragma solidity ^0.8.22;

import {Test, console} from "forge-std/Test.sol";
import {MultiSigAccount, MSAFactory} from "../src/MultiSig.sol";

// Mock ERC20 contract for testing
contract MockERC20 {
    mapping(address => uint256) public balanceOf;
    mapping(address => mapping(address => uint256)) public allowance;
    
    string public name = "Mock Token";
    string public symbol = "MOCK";
    uint8 public decimals = 18;
    uint256 public totalSupply = 1000000 * 10**18;
    
    event Transfer(address indexed from, address indexed to, uint256 value);
    event Approval(address indexed owner, address indexed spender, uint256 value);
    
    constructor() {
        balanceOf[msg.sender] = totalSupply;
    }
    
    function transfer(address to, uint256 value) external returns (bool) {
        require(balanceOf[msg.sender] >= value, "Insufficient balance");
        balanceOf[msg.sender] -= value;
        balanceOf[to] += value;
        emit Transfer(msg.sender, to, value);
        return true;
    }
    
    function approve(address spender, uint256 value) external returns (bool) {
        allowance[msg.sender][spender] = value;
        emit Approval(msg.sender, spender, value);
        return true;
    }
    
    function transferFrom(address from, address to, uint256 value) external returns (bool) {
        require(balanceOf[from] >= value, "Insufficient balance");
        require(allowance[from][msg.sender] >= value, "Insufficient allowance");
        
        balanceOf[from] -= value;
        balanceOf[to] += value;
        allowance[from][msg.sender] -= value;
        
        emit Transfer(from, to, value);
        return true;
    }
}

// Mock ERC721 contract for testing
contract MockERC721 {
    mapping(uint256 => address) public ownerOf;
    mapping(address => uint256) public balanceOf;
    mapping(uint256 => address) public getApproved;
    mapping(address => mapping(address => bool)) public isApprovedForAll;
    
    string public name = "Mock NFT";
    string public symbol = "MNFT";
    uint256 public nextTokenId = 1;
    
    event Transfer(address indexed from, address indexed to, uint256 indexed tokenId);
    event Approval(address indexed owner, address indexed approved, uint256 indexed tokenId);
    event ApprovalForAll(address indexed owner, address indexed operator, bool approved);
    
    function mint(address to) external returns (uint256) {
        uint256 tokenId = nextTokenId++;
        ownerOf[tokenId] = to;
        balanceOf[to]++;
        emit Transfer(address(0), to, tokenId);
        return tokenId;
    }
    
    function safeTransferFrom(address from, address to, uint256 tokenId) external {
        require(ownerOf[tokenId] == from, "Not owner");
        require(
            msg.sender == from || 
            getApproved[tokenId] == msg.sender || 
            isApprovedForAll[from][msg.sender],
            "Not approved"
        );
        
        ownerOf[tokenId] = to;
        balanceOf[from]--;
        balanceOf[to]++;
        delete getApproved[tokenId];
        
        emit Transfer(from, to, tokenId);
        
        // Check if recipient can receive NFT
        if (to.code.length > 0) {
            try IERC721Receiver(to).onERC721Received(msg.sender, from, tokenId, "") returns (bytes4 response) {
                if (response != IERC721Receiver.onERC721Received.selector) {
                    revert("ERC721: transfer to non ERC721Receiver implementer");
                }
            } catch (bytes memory reason) {
                if (reason.length == 0) {
                    revert("ERC721: transfer to non ERC721Receiver implementer");
                } else {
                    assembly {
                        revert(add(32, reason), mload(reason))
                    }
                }
            }
        }
    }
    
    function approve(address to, uint256 tokenId) external {
        address owner = ownerOf[tokenId];
        require(msg.sender == owner || isApprovedForAll[owner][msg.sender], "Not authorized");
        getApproved[tokenId] = to;
        emit Approval(owner, to, tokenId);
    }
    
    function setApprovalForAll(address operator, bool approved) external {
        isApprovedForAll[msg.sender][operator] = approved;
        emit ApprovalForAll(msg.sender, operator, approved);
    }
    
    function supportsInterface(bytes4 interfaceId) external pure returns (bool) {
        return interfaceId == 0x80ac58cd || // ERC721
               interfaceId == 0x5b5e139f || // ERC721Metadata
               interfaceId == 0x01ffc9a7;   // ERC165
    }
}

interface IERC721Receiver {
    function onERC721Received(address operator, address from, uint256 tokenId, bytes calldata data) external returns (bytes4);
}

contract MultiSigTest is Test {
    MultiSigAccount public multiSig;
    MSAFactory public factory;
    MockERC20 public mockToken;
    MockERC721 public mockNFT;
    
    address[] public owners;
    address public owner1 = address(0x1);
    address public owner2 = address(0x2);
    address public owner3 = address(0x3);
    address public nonOwner = address(0x4);
    address public recipient = address(0x5);
    
    uint16 public constant PIN = 1234;
    uint public constant REQUIRED = 2;
    
    event Confirmation(address indexed sender, uint indexed transactionId);
    event Revocation(address indexed sender, uint indexed transactionId);
    event Submission(uint indexed transactionId, address dest, uint256 value, bytes func);
    event Execution(uint transactionId, address indexed to, uint indexed amount);
    event ExecutionFailure(uint indexed transactionId);
    event Deposit(address sender, uint value);
    event OwnerAddition(address indexed owner);
    event OwnerRemoval(address indexed owner);
    event OwnerReplace(address indexed oldOwner, address indexed newOwner);
    event RequirementChange(uint required);
    event NftReceived(address operator, address from, uint256 tokenId, bytes data);
    
    function setUp() public {
        owners.push(owner1);
        owners.push(owner2);
        owners.push(owner3);
        
        multiSig = new MultiSigAccount(owners, REQUIRED, PIN);
        factory = new MSAFactory();
        mockToken = new MockERC20();
        mockNFT = new MockERC721();
        
        // Fund the multisig with some ETH
        vm.deal(address(multiSig), 10 ether);
        
        // Give multisig some tokens and NFTs for testing
        mockToken.transfer(address(multiSig), 1000 * 10**18);
        uint256 tokenId = mockNFT.mint(address(this));
        mockNFT.safeTransferFrom(address(this), address(multiSig), tokenId);
    }

    // ========== CONSTRUCTOR TESTS ==========
    
    function test_Constructor() public {
        address[] memory testOwners = multiSig.getOwners();
        assertEq(testOwners.length, 3);
        assertEq(testOwners[0], owner1);
        assertEq(testOwners[1], owner2);
        assertEq(testOwners[2], owner3);
        assertEq(multiSig.required(), REQUIRED);
        assertTrue(multiSig.isOwner(owner1));
        assertTrue(multiSig.isOwner(owner2));
        assertTrue(multiSig.isOwner(owner3));
        assertFalse(multiSig.isOwner(nonOwner));
    }

    function test_Constructor_RevertInvalidRequirement() public {
        address[] memory invalidOwners = new address[](1);
        invalidOwners[0] = owner1;
        
        vm.expectRevert();
        new MultiSigAccount(invalidOwners, 2, PIN); // required > owners
    }

    function test_Constructor_RevertZeroRequirement() public {
        vm.expectRevert();
        new MultiSigAccount(owners, 0, PIN);
    }

    function test_Constructor_RevertDuplicateOwner() public {
        address[] memory duplicateOwners = new address[](2);
        duplicateOwners[0] = owner1;
        duplicateOwners[1] = owner1; // duplicate
        
        vm.expectRevert();
        new MultiSigAccount(duplicateOwners, 1, PIN);
    }

    // ========== RECEIVE FUNCTION TESTS ==========
    
    function test_Receive() public {
        uint256 initialBalance = address(multiSig).balance;
        uint256 sendAmount = 1 ether;
        
        vm.expectEmit(true, false, false, true);
        emit Deposit(address(this), sendAmount);
        
        (bool success,) = address(multiSig).call{value: sendAmount}("");
        assertTrue(success);
        assertEq(address(multiSig).balance, initialBalance + sendAmount);
    }

    // ========== OWNER MANAGEMENT TESTS ==========
    
    // NOTE: Owner management functions now require multi-sig approval (submit → confirm → execute)
    // These tests need to be updated to use the proper multi-sig flow
    function test_AddOwner() public {
        address newOwner = address(0x6);
        
        vm.prank(owner1);
        vm.expectEmit(true, false, false, false);
        emit OwnerAddition(newOwner);
        
        // TODO: Update to use submitAddOwner → execute flow
        // multiSig.addOwner(newOwner, PIN);
        
        assertTrue(multiSig.isOwner(newOwner));
        address[] memory updatedOwners = multiSig.getOwners();
        assertEq(updatedOwners.length, 4);
    }

    function test_AddOwner_RevertNotOwner() public {
        address newOwner = address(0x6);
        
        vm.prank(nonOwner);
        vm.expectRevert("account: not Owner or EntryPoint");
        multiSig.addOwner(newOwner, PIN);
    }

    function test_AddOwner_RevertWrongPin() public {
        address newOwner = address(0x6);
        
        vm.prank(owner1);
        vm.expectRevert("incorrect pin");
        multiSig.addOwner(newOwner, 9999);
    }

    function test_AddOwner_RevertOwnerExists() public {
        vm.prank(owner1);
        vm.expectRevert();
        multiSig.addOwner(owner2, PIN); // owner2 already exists
    }

    function test_RemoveOwner() public {
        vm.prank(owner1);
        vm.expectEmit(true, false, false, false);
        emit OwnerRemoval(owner3);
        
        multiSig.removeOwner(owner3, PIN);
        
        assertFalse(multiSig.isOwner(owner3));
        address[] memory updatedOwners = multiSig.getOwners();
        assertEq(updatedOwners.length, 2);
    }

    function test_RemoveOwner_RevertNotOwner() public {
        vm.prank(nonOwner);
        vm.expectRevert("account: not Owner or EntryPoint");
        multiSig.removeOwner(owner3, PIN);
    }

    function test_RemoveOwner_RevertWrongPin() public {
        vm.prank(owner1);
        vm.expectRevert("incorrect pin");
        multiSig.removeOwner(owner3, 9999);
    }

    function test_ReplaceOwner() public {
        address newOwner = address(0x6);
        
        vm.prank(owner1);
        vm.expectEmit(true, true, false, false);
        emit OwnerReplace(owner3, newOwner);
        
        multiSig.replaceOwner(owner3, newOwner, PIN);
        
        assertFalse(multiSig.isOwner(owner3));
        assertTrue(multiSig.isOwner(newOwner));
        
        address[] memory updatedOwners = multiSig.getOwners();
        assertEq(updatedOwners.length, 3);
    }

    function test_ReplaceOwner_RevertWrongPin() public {
        address newOwner = address(0x6);
        
        vm.prank(owner1);
        vm.expectRevert("incorrect pin");
        multiSig.replaceOwner(owner3, newOwner, 9999);
    }

    function test_ChangeRequirement() public {
        vm.prank(owner1);
        vm.expectEmit(false, false, false, true);
        emit RequirementChange(3);
        
        multiSig.changeRequirement(3);
        
        assertEq(multiSig.required(), 3);
    }

    function test_ChangeRequirement_RevertNotOwner() public {
        vm.prank(nonOwner);
        vm.expectRevert("account: not Owner or EntryPoint");
        multiSig.changeRequirement(3);
    }

    function test_ChangeRequirement_RevertInvalidRequirement() public {
        vm.prank(owner1);
        vm.expectRevert();
        multiSig.changeRequirement(5); // greater than owner count
    }

    // ========== TRANSACTION TESTS ==========
    
    function test_SubmitTransaction() public {
        bytes memory data = abi.encodeWithSignature("transfer(address,uint256)", recipient, 1 ether);
        
        vm.prank(owner1);
        vm.expectEmit(true, false, false, true);
        emit Submission(0, recipient, 1 ether, data);
        
        uint256 txId = multiSig.submitTransaction(recipient, 1 ether, data);
        
        assertEq(txId, 0);
        assertEq(multiSig.transactionCount(), 1);
        
        (address dest, uint256 value, bytes memory func, bool executed, uint256 id) = multiSig.transactions(txId);
        assertEq(dest, recipient);
        assertEq(value, 1 ether);
        assertEq(func, data);
        assertFalse(executed);
        assertEq(id, txId);
    }

    function test_SubmitTransaction_RevertNotOwner() public {
        bytes memory data = "";
        
        vm.prank(nonOwner);
        vm.expectRevert("account: not Owner or EntryPoint");
        multiSig.submitTransaction(recipient, 1 ether, data);
    }

    function test_ConfirmTransaction() public {
        // Submit transaction first
        vm.prank(owner1);
        uint256 txId = multiSig.submitTransaction(recipient, 1 ether, "");
        
        // Confirm by owner2
        vm.prank(owner2);
        vm.expectEmit(true, true, false, false);
        emit Confirmation(owner2, txId);
        
        multiSig.confirmTransaction(txId);
        
        assertEq(multiSig.getConfirmationCount(txId), 2); // owner1 auto-confirmed + owner2
    }

    function test_ConfirmTransaction_RevertNotOwner() public {
        vm.prank(owner1);
        uint256 txId = multiSig.submitTransaction(recipient, 1 ether, "");
        
        vm.prank(nonOwner);
        vm.expectRevert();
        multiSig.confirmTransaction(txId);
    }

    function test_ConfirmTransaction_RevertAlreadyConfirmed() public {
        vm.prank(owner1);
        uint256 txId = multiSig.submitTransaction(recipient, 1 ether, "");
        
        vm.prank(owner1);
        vm.expectRevert();
        multiSig.confirmTransaction(txId); // owner1 already confirmed during submission
    }

    function test_RevokeConfirmation() public {
        vm.prank(owner1);
        uint256 txId = multiSig.submitTransaction(recipient, 1 ether, "");
        
        vm.prank(owner1);
        vm.expectEmit(true, true, false, false);
        emit Revocation(owner1, txId);
        
        multiSig.revokeConfirmation(txId);
        
        assertEq(multiSig.getConfirmationCount(txId), 0);
    }

    function test_RevokeConfirmation_RevertNotConfirmed() public {
        vm.prank(owner1);
        uint256 txId = multiSig.submitTransaction(recipient, 1 ether, "");
        
        vm.prank(owner2);
        vm.expectRevert();
        multiSig.revokeConfirmation(txId); // owner2 never confirmed
    }

    function test_Execute() public {
        uint256 initialBalance = recipient.balance;
        
        // Submit and confirm transaction
        vm.prank(owner1);
        uint256 txId = multiSig.submitTransaction(recipient, 1 ether, "");
        
        vm.prank(owner2);
        multiSig.confirmTransaction(txId);
        
        // Execute
        vm.prank(owner1);
        vm.expectEmit(true, true, true, false);
        emit Execution(txId, recipient, 1 ether);
        
        multiSig.execute(txId);
        
        assertEq(recipient.balance, initialBalance + 1 ether);
        
        (, , , bool executed, ) = multiSig.transactions(txId);
        assertTrue(executed);
    }

    function test_Execute_RevertNotOwner() public {
        vm.prank(owner1);
        uint256 txId = multiSig.submitTransaction(recipient, 1 ether, "");
        
        vm.prank(owner2);
        multiSig.confirmTransaction(txId);
        
        vm.prank(nonOwner);
        vm.expectRevert("account: not Owner or EntryPoint");
        multiSig.execute(txId);
    }

    function test_Execute_RevertNotConfirmed() public {
        vm.prank(owner1);
        uint256 txId = multiSig.submitTransaction(recipient, 1 ether, "");
        
        vm.prank(owner1);
        vm.expectRevert();
        multiSig.execute(txId); // only 1 confirmation, need 2
    }

    function test_IsConfirmed() public {
        vm.prank(owner1);
        uint256 txId = multiSig.submitTransaction(recipient, 1 ether, "");
        
        assertFalse(multiSig.isConfirmed(txId)); // only 1 confirmation
        
        vm.prank(owner2);
        multiSig.confirmTransaction(txId);
        
        assertTrue(multiSig.isConfirmed(txId)); // now 2 confirmations
    }

    // ========== ERC20 TRANSFER TESTS ==========
    
    function test_SubmitTransferERC20() public {
        uint256 transferAmount = 100 * 10**18;
        
        vm.prank(owner1);
        uint256 txId = multiSig.submitTransferERC20(address(mockToken), recipient, transferAmount);
        
        assertEq(txId, 0);
        
        (address dest, uint256 value, bytes memory func, , ) = multiSig.transactions(txId);
        assertEq(dest, address(mockToken));
        assertEq(value, 0);
        
        bytes memory expectedData = abi.encodeWithSelector(mockToken.transfer.selector, recipient, transferAmount);
        assertEq(func, expectedData);
    }

    function test_ExecuteERC20Transfer() public {
        uint256 transferAmount = 100 * 10**18;
        uint256 initialBalance = mockToken.balanceOf(recipient);
        
        // Submit ERC20 transfer
        vm.prank(owner1);
        uint256 txId = multiSig.submitTransferERC20(address(mockToken), recipient, transferAmount);
        
        // Confirm and execute
        vm.prank(owner2);
        multiSig.confirmTransaction(txId);
        
        vm.prank(owner1);
        multiSig.execute(txId);
        
        assertEq(mockToken.balanceOf(recipient), initialBalance + transferAmount);
        assertEq(mockToken.balanceOf(address(multiSig)), 1000 * 10**18 - transferAmount);
    }

    // ========== ERC721 TRANSFER TESTS ==========
    
    function test_SubmitTransferNFT() public {
        uint256 tokenId = 1;
        
        vm.prank(owner1);
        uint256 txId = multiSig.submitTransferNFT(address(mockNFT), recipient, tokenId);
        
        assertEq(txId, 0);
        
        (address dest, uint256 value, bytes memory func, , ) = multiSig.transactions(txId);
        assertEq(dest, address(mockNFT));
        assertEq(value, 0);
        
        bytes memory expectedData = abi.encodeWithSelector(mockNFT.safeTransferFrom.selector, address(multiSig), recipient, tokenId);
        assertEq(func, expectedData);
    }

    function test_ExecuteNFTTransfer() public {
        uint256 tokenId = 1;
        
        // Submit NFT transfer
        vm.prank(owner1);
        uint256 txId = multiSig.submitTransferNFT(address(mockNFT), recipient, tokenId);
        
        // Confirm and execute
        vm.prank(owner2);
        multiSig.confirmTransaction(txId);
        
        vm.prank(owner1);
        multiSig.execute(txId);
        
        assertEq(mockNFT.ownerOf(tokenId), recipient);
        assertEq(mockNFT.balanceOf(address(multiSig)), 0);
        assertEq(mockNFT.balanceOf(recipient), 1);
    }

    // ========== NFT RECEIVER TESTS ==========
    
    function test_OnERC721Received() public {
        uint256 tokenId = mockNFT.mint(address(this));
        
        vm.expectEmit(true, true, true, true);
        emit NftReceived(address(this), address(this), tokenId, "");
        
        mockNFT.safeTransferFrom(address(this), address(multiSig), tokenId);
        
        assertEq(mockNFT.ownerOf(tokenId), address(multiSig));
    }

    // ========== VIEW FUNCTION TESTS ==========
    
    function test_GetOwners() public {
        address[] memory retrievedOwners = multiSig.getOwners();
        assertEq(retrievedOwners.length, 3);
        assertEq(retrievedOwners[0], owner1);
        assertEq(retrievedOwners[1], owner2);
        assertEq(retrievedOwners[2], owner3);
    }

    function test_GetConfirmations() public {
        vm.prank(owner1);
        uint256 txId = multiSig.submitTransaction(recipient, 1 ether, "");
        
        vm.prank(owner2);
        multiSig.confirmTransaction(txId);
        
        address[] memory confirmations = multiSig.getConfirmations(txId);
        assertEq(confirmations.length, 2);
        assertEq(confirmations[0], owner1);
        assertEq(confirmations[1], owner2);
    }

    function test_GetConfirmationCount() public {
        vm.prank(owner1);
        uint256 txId = multiSig.submitTransaction(recipient, 1 ether, "");
        
        assertEq(multiSig.getConfirmationCount(txId), 1);
        
        vm.prank(owner2);
        multiSig.confirmTransaction(txId);
        
        assertEq(multiSig.getConfirmationCount(txId), 2);
    }

    // ========== FACTORY TESTS ==========
    
    function test_Factory_NewMSA() public {
        uint256 fee = 999999999999999;
        
        vm.expectEmit(false, false, false, false);
        emit MSAFactory.NewMSACreated(address(0), bytes32(0)); // We can't predict the address and salt
        
        MultiSigAccount newMSA = factory.newMSA{value: fee + 1}(owners, REQUIRED, PIN);
        
        assertTrue(address(newMSA) != address(0));
        assertEq(newMSA.required(), REQUIRED);
        
        address[] memory newOwners = newMSA.getOwners();
        assertEq(newOwners.length, 3);
    }

    function test_Factory_NewMSA_RevertInsufficientFee() public {
        uint256 fee = 999999999999999;
        
        vm.expectRevert("Ether value sent is not correct");
        factory.newMSA{value: fee - 1}(owners, REQUIRED, PIN);
    }

    function test_Factory_ChangeFee() public {
        uint256 newFee = 2000000000000000;
        
        factory.changeFee(newFee);
        
        // Test that new fee is applied
        vm.expectRevert("Ether value sent is not correct");
        factory.newMSA{value: 999999999999999}(owners, REQUIRED, PIN); // old fee
    }

    function test_Factory_ChangeFee_RevertNotOwner() public {
        vm.prank(nonOwner);
        vm.expectRevert("Caller is not the owner");
        factory.changeFee(2000000000000000);
    }

    function test_Factory_Withdraw() public {
        uint256 fee = 999999999999999;
        factory.newMSA{value: fee + 1}(owners, REQUIRED, PIN);
        
        uint256 initialBalance = address(this).balance;
        uint256 contractBalance = address(factory).balance;
        
        factory.withdraw();
        
        assertEq(address(factory).balance, 0);
        assertEq(address(this).balance, initialBalance + contractBalance);
    }

    function test_Factory_Withdraw_RevertNotOwner() public {
        vm.prank(nonOwner);
        vm.expectRevert("Caller is not the owner");
        factory.withdraw();
    }

    // Helper function to receive ETH
    receive() external payable {}
}
